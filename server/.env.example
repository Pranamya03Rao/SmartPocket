# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/smart-budget

# JWT Secrets (change in production!)
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-minimum-32-characters
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-minimum-32-characters

# AES-256 encryption key (32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email (optional in dev - logs to console if not set)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@smartbudget.com
